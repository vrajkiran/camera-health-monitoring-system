DATABASE_PATH=backend/cc_camera_demo.db

# Local demo allows the default JWT secret. Set false and a strong JWT_SECRET before any real deployment.
DEMO_MODE=true

# Gmail SMTP email alert settings.
# Use a Gmail App Password, not your normal Gmail password.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
ADMIN_EMAIL=admin@example.com

# Telegram alert settings.
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-strong-random-secret
